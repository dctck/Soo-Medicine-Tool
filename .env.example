# Set in Netlify environment variables with Functions scope. Never commit real secrets.
ADMIN_PASSWORD_HASH=
# Optional Naver blog ID; also editable in CMS.
NAVER_BLOG_ID=
# Optional inquiry email notifications (Resend). Set only in Netlify Functions environment.
RESEND_API_KEY=
# Plain email address on a domain verified in Resend; do not enter a Gmail address as sender.
INQUIRY_FROM_EMAIL=
# Optional R2 media storage. Keep real keys only in Netlify Functions environment.
# Leave MEDIA_STORAGE=netlify until the connection has been verified.
MEDIA_STORAGE=netlify
R2_ACCOUNT_ID=
R2_BUCKET=soo-clinic-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Single HTTPS origin, e.g. https://images.your-clinic-domain.example
# Must be available in BOTH Builds and Functions to allow this exact host in CSP.
R2_PUBLIC_BASE_URL=
